# ============================================================
# cartpole 固件 SDK 配置默认值
# 目标：ESP32-S3-WROOM-1-N16R8（16MB Quad Flash + 8MB Octal PSRAM）
# ============================================================

# ---- Target Chip ----
CONFIG_IDF_TARGET="esp32s3"

# ---- CPU & Clock ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- Partition Table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- PSRAM (Octal, 8MB - N16R8) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- Watchdog ----
# Interrupt watchdog on all cores
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_INT_WDT_CHECK_CPU1=y

# Task watchdog (initialized at startup)
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# Panic on task-WDT timeout：卡死任务无法再喂狗，带电机带电继续运行不可
# 接受，重启使故障可见可恢复。重启后 EN 为高（驱动不使能）、无运动目标。
# 代价：位置基准丢失，回零原点需重新建立（重新 HOME）。
CONFIG_ESP_TASK_WDT_PANIC=y

# ---- Logging ----
# Default log level: Info (can be overridden per-component at runtime)
# Note: Release build strips all ESP_LOG at compile time via CMakeLists.txt
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# ---- UART0 (console / log) ----
# rev2：日志/烧录走原生 USB（io19/20），UART0（43/44）整让给协议通道
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- Timing ----
CONFIG_ESP_TIME_FUNCS_USE_ESP_TIMER=y
