menu "cartfsm - 模式机"

config CARTFSM_SELF_TEST
    bool "上电运行 cartfsm 核心自测"
    default n
    help
        启用后在启动时运行转换表/软限位/注册表向量自测
        （不驱动电机）。结束行 "SELF-TEST DONE: <n>/<total> PASS"。

config CARTFSM_DIAG_ACTIVE_HIGH
    bool "DIAG1 堵转有效电平为高"
    default y
    help
        true：DIAG1 高电平视为堵转；false：低有效。
        TMC2209 DIAG 推挽输出，极性上板以低速手堵验证
        （上板清单 T8-②），不符时改此开关。

config CARTFSM_FLOW_TEST
    bool "上板流程自测（驱动 EN，含 12V 时小车会真实运动）"
    default n
    help
        在核心自测之上追加注入式流程用例：HOME→注入堵转→READY
        且原点重置为 −265 mm；HOME 超时→FAULT；编码器失联注入
        →FAULT 优先于超时；RESET 后可重新 HOME。
        需要 cartfsm_start 已运行；会开 EN。

endmenu
